# Runtime server-only settings. Use npm run setup:local for local development.
# For a separately approved hosted development project, enter these privately.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# True for HTTPS private review (Codespaces); false for local HTTP development.
APP_COOKIE_SECURE=false
# Never set service_role/sb_secret credentials as the app's anon/publishable key.

# M2A: server only. Configure the API key privately; never NEXT_PUBLIC_.
CONCIERGE_OPENAI_KEY=
# Generated by local setup; do not put its value into source or chat.
CONCIERGE_GUARD_TOKEN=
# Enable only in access-protected private prototype review.
CONCIERGE_PRIVATE_PROTOTYPE=false
# Remain disabled until secure key/rate review and the authorised USD 5 trial enable step.
CONCIERGE_AI_ENABLED=false
CONCIERGE_RATE_CEILINGS_CONFIRMED=false
